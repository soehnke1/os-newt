+# ANY EXPRESS OR IMPLIED WARRANTIES, INCLUDING, BUT NOT LIMITED TO, THE IMPLIED
+# WARRANTIES OF MERCHANTABILITY AND FITNESS FOR A PARTICULAR PURPOSE ARE DISCLAIMED.
+# IN NO EVENT SHALL THE COPYRIGHT HOLDER OR CONTRIBUTORS BE LIABLE FOR ANY DIRECT,
+# INDIRECT, INCIDENTAL, SPECIAL, EXEMPLARY, OR CONSEQUENTIAL DAMAGES (INCLUDING,
+# BUT NOT LIMITED TO, PROCUREMENT OF SUBSTITUTE GOODS OR SERVICES; LOSS OF USE,
+# DATA, OR PROFITS; OR BUSINESS INTERRUPTION) HOWEVER CAUSED AND ON ANY THEORY OF
+# LIABILITY, WHETHER IN CONTRACT, STRICT LIABILITY, OR TORT (INCLUDING NEGLIGENCE
+# OR OTHERWISE) ARISING IN ANY WAY OUT OF THE USE OF THIS SOFTWARE, EVEN IF ADVISED
+# OF THE POSSIBILITY OF SUCH DAMAGE.
+
+# PROVIDE: newt
+# REQUIRE: NETWORKING SERVERS
+# KEYWORD: shutdown
+
+# shellcheck source=/dev/null
+. /etc/rc.subr
+
+# rc.subr consumes these service metadata variables.
+name="newt"
+rcvar="newt_enable"
+load_rc_config "$name"
+: "${newt_enable:=NO}"
+
+pidfile="/var/run/newt.pid"
+required_files="%%PREFIX%%/etc/newt/config.json"
+required_dirs="%%PREFIX%%/etc/newt"
+command="/usr/sbin/daemon"
+procname="/usr/sbin/daemon"
+start_precmd="newt_prestart"
+# Stop the supervisor, so an intentional stop cannot respawn Newt.
+# Credentials stay in the config file and do not appear in process arguments.
+command_args="-f -r -R 5 -P ${pidfile} -p /var/run/newt.child.pid -S -T newt %%PREFIX%%/bin/newt --config-file %%PREFIX%%/etc/newt/config.json"
+
+newt_prestart()
+{
+    if [ ! -x %%PREFIX%%/bin/newt ]; then
+        warn "Newt binary missing: %%PREFIX%%/bin/newt"
+        return 1
+    fi
+    if [ "$(/usr/bin/stat -f '%u:%Lp' %%PREFIX%%/etc/newt/config.json)" != "0:600" ]; then
+        warn "Config must belong to root and have mode 600."
+        return 1
+    fi
+}
+
+run_rc_command "$1"
